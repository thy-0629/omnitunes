# Auto-detect text files, normalize line endings on commit
* text=auto eol=lf

# Force LF for shell-friendly files
*.sh        text eol=lf
*.bash      text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.cjs       text eol=lf
*.mjs       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.env       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Mark binaries explicitly
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.mp3  binary
*.mp4  binary
*.wav  binary
*.flac binary

# Avoid line-ending churn on Windows
Dockerfile      text eol=lf
.dockerignore   text eol=lf
