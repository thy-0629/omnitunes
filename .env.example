# ===== Server =====
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ===== Auth (MVP: single user) =====
# A long random string used as bearer token for the only local user
AUTH_TOKEN=change-me-in-production

# ===== CORS =====
# Comma-separated list. Use * for development.
CORS_ORIGIN=http://localhost:5173

# ===== Data (used in later phases) =====
# DATABASE_URL=file:./data/omnitune.sqlite
# MEDIA_DIR=./data/media
# CACHE_DIR=./data/cache
