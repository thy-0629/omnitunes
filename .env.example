# ===== Server =====
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ===== Auth (MVP: single user) =====
# A long random string used as bearer token for the only local user
AUTH_TOKEN=change-me-in-production

# ===== CORS =====
# Comma-separated list. Use * for development.
CORS_ORIGIN=http://localhost:5173

# ===== Data =====
DATABASE_URL=file:./data/omnitune.sqlite
MEDIA_DIR=./data/media
CACHE_DIR=./data/cache

# ===== Lifecycle =====
LIFECYCLE_RETENTION_DAYS=30
LIFECYCLE_INTERVAL_HOURS=24

# ===== Cache =====
SEARCH_CACHE_TTL_SEC=60
SEARCH_CACHE_MAX_ENTRIES=100
PLAY_OPTIONS_CACHE_TTL_SEC=30
PLAY_OPTIONS_CACHE_MAX_ENTRIES=500

# ===== Bilibili (optional, keyless) =====
# Anonymous search works but may hit risk-control (-412); pasting your browser's
# SESSDATA cookie improves stability. Never commit a real value.
BILIBILI_SESSDATA=
BILIBILI_MIN_INTERVAL_MS=800
BILIBILI_WBI_TTL_SEC=86400
